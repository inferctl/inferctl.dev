---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="inferctl — Explain your local LLM stack" description="Inspect local inference backends, models, and routing decisions.">
  <section class="hero">
    <h1 class="wordmark"><span>infer</span><span class="ctl">ctl</span></h1>
    <p class="tagline">Local inference control plane</p>
    <h2>Explain your local LLM stack.</h2>
    <p>inferctl inspects local inference backends, loaded models, and routing decisions. It stays outside your inference request path.</p>
    <p class="actions"><a class="button" href="/docs/">Read the docs</a> <a href="https://github.com/inferctl/inferctl">View source</a></p>
  </section>
</BaseLayout>

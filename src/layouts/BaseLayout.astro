---
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle.astro';

interface Props {
  title: string;
  description: string;
  bodyClass?: string;
}

const { title, description, bodyClass = '' } = Astro.props;
---
<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" />
    <link rel="canonical" href={new URL(Astro.url.pathname, 'https://inferctl.dev')} />
    <title>{title}</title>
    <script is:inline>
      (() => {
        const stored = localStorage.getItem('inferctl-theme');
        if (stored === 'light' || stored === 'dark') {
          document.documentElement.setAttribute('data-theme', stored);
        }
      })();
    </script>
  </head>
  <body class={bodyClass}>
    <header class="site-header">
      <nav aria-label="Main navigation">
        <a class="brand" href="/"><span>infer</span><span class="ctl">ctl</span></a>
        <span class="tagline">Explain your local LLM stack.</span>
        <div class="nav-links">
          <a href="/docs/">Docs</a>
          <a href="https://github.com/inferctl/inferctl">GitHub</a>
        </div>
        <ThemeToggle />
      </nav>
    </header>
    <main><slot /></main>
    <footer>
      <span>inferctl</span>
      <a href="https://github.com/inferctl/inferctl">Source code</a>
    </footer>
  </body>
</html>

---
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle.astro';

interface Props {
  title: string;
  description: string;
  bodyClass?: string;
}

const { title, description, bodyClass = '' } = Astro.props;

// Emit Organization structured data once, on the homepage. inferctl is its own
// entity (own GitHub org) and one product in the Ozhiaki house of brands; the
// parentOrganization link (reciprocated by subOrganization on ozhiaki.com)
// fuses the separate domains into one entity graph for search.
const isHome = Astro.url.pathname === '/';
const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'inferctl',
  url: 'https://inferctl.dev/',
  logo: new URL('/favicon.svg', 'https://inferctl.dev').href,
  description: 'Explain your local LLM stack.',
  sameAs: ['https://github.com/inferctl'],
  parentOrganization: {
    '@type': 'Organization',
    name: 'Ozhiaki Labs',
    url: 'https://www.ozhiaki.com/',
  },
};
---
<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" />
    <link rel="canonical" href={new URL(Astro.url.pathname, 'https://inferctl.dev')} />
    <title>{title}</title>
    {isHome && (
      <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    )}
    <script is:inline>
      (() => {
        const stored = localStorage.getItem('inferctl-theme');
        if (stored === 'light' || stored === 'dark') {
          document.documentElement.setAttribute('data-theme', stored);
        }
      })();
    </script>
  </head>
  <body class={bodyClass}>
    <header class="site-header">
      <nav aria-label="Main navigation">
        <a class="brand" href="/"><span>infer</span><span class="ctl">ctl</span></a>
        <span class="tagline">Explain your local LLM stack.</span>
        <div class="nav-links">
          <a href="/docs/">Docs</a>
          <a href="https://github.com/inferctl">Repos</a>
          <a href="/blog/">Blog</a>
          <a href="https://github.com/inferctl/inferctl">GitHub</a>
        </div>
        <ThemeToggle />
      </nav>
    </header>
    <main><slot /></main>
    <footer>
      <span>inferctl</span>
      <a href="https://github.com/inferctl/inferctl">Source code</a>
    </footer>
  </body>
</html>

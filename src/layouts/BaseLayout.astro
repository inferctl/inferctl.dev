---
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle.astro';
import { siteConfig } from '../lib/site-config';

interface Props {
  title: string;
  description: string;
  bodyClass?: string;
}

const { title, description, bodyClass = '' } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, siteConfig.siteUrl);
const cardUrl = new URL('/og.png', siteConfig.siteUrl);
const cardAlt = 'inferctl. Explain your local LLM stack. Local inference control plane. Inspect backends, models, and routes. Your client connects to the backend.';

// Emit Organization structured data once, on the homepage. inferctl is its own
// entity (own GitHub org) and one product in the Ozhiaki house of brands; the
// parentOrganization link (reciprocated by subOrganization on ozhiaki.com)
// fuses the separate domains into one entity graph for search.
const isHome = Astro.url.pathname === '/';
const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': 'https://inferctl.dev/#organization',
  name: 'inferctl',
  url: 'https://inferctl.dev/',
  logo: new URL('/favicon.svg', 'https://inferctl.dev').href,
  description: 'Explain your local LLM stack.',
  sameAs: ['https://github.com/inferctl'],
  // Reference the canonical Ozhiaki Labs org node by exact @id (byte-identical
  // to the @id it declares on www.ozhiaki.com), not by url/name string match.
  // This is the strong parent<->child edge spoolctl.dev already uses.
  parentOrganization: {
    '@id': 'https://www.ozhiaki.com/#organization',
  },
};
---
<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />
    <title>{title}</title>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={cardUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="2400" />
    <meta property="og:image:height" content="1260" />
    <meta property="og:image:alt" content={cardAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={cardUrl} />
    <meta name="twitter:image:alt" content={cardAlt} />
    {isHome && (
      <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    )}
    <script is:inline>
      (() => {
        const stored = localStorage.getItem('inferctl-theme');
        if (stored === 'light' || stored === 'dark') {
          document.documentElement.setAttribute('data-theme', stored);
        }
      })();
    </script>
  </head>
  <body class={bodyClass}>
    <header class="site-header">
      <nav aria-label="Main navigation">
        <a class="brand" href="/"><span>infer</span><span class="ctl">ctl</span></a>
        <span class="tagline">Explain your local LLM stack.</span>
        <div class="nav-links">
          <a href="/docs/">Docs</a>
          <a href="https://github.com/inferctl">Repos</a>
          <a href="/blog/">Blog</a>
          <a href="https://github.com/inferctl/inferctl">GitHub</a>
        </div>
        <ThemeToggle />
      </nav>
    </header>
    <main><slot /></main>
    <footer>
      <span>inferctl</span>
      <a href="https://github.com/inferctl/inferctl">Source code</a>
    </footer>
  </body>
</html>
